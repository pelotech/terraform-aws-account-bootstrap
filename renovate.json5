{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  'pre-commit': {
    enabled: true,
  },
  minimumReleaseAge: '7 days',
  packageRules: [
    {
      description: 'Group pre-commit hook and tflint plugin updates into one PR',
      matchManagers: [
        'pre-commit',
        'tflint-plugin',
      ],
      groupName: 'lint tooling',
    },
    {
      description: 'Group GitHub Actions minor and patch updates into one PR',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      groupName: 'github actions',
    },
  ],
}
